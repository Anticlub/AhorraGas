# Plantilla de configuración de firma para el build de release.
#
# 1. Copia este archivo como `keystore.properties` (que está en .gitignore).
# 2. Genera un keystore si no tienes uno (guárdalo fuera del repo):
#    keytool -genkey -v -keystore ahorragas-release.jks \
#            -keyalg RSA -keysize 2048 -validity 10000 -alias ahorragas
# 3. Rellena las rutas y contraseñas reales abajo.
#
# IMPORTANTE: guarda el .jks y estas contraseñas en un sitio seguro. Si los
# pierdes, Google Play NO te dejará volver a firmar actualizaciones de la app.

storeFile=/ruta/absoluta/a/ahorragas-release.jks
storePassword=CAMBIA_ESTO
keyAlias=ahorragas
keyPassword=CAMBIA_ESTO
